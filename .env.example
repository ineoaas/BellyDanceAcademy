# Copy to .env (git-ignored). Read by the backend in local dev and by docker compose.
# Everything is optional locally: without keys, emails are logged to the console
# and payment/video features return a clear "not configured" error.

# Public URL of the frontend — used in emails and Stripe/Mux redirects
APP_URL=http://localhost:3000

# Email (https://resend.com)
RESEND_API_KEY=

# Payments (https://dashboard.stripe.com) — Connect must be enabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Video (https://dashboard.mux.com)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# Sender for all emails; the domain must be verified in Resend
# MAIL_FROM=Belly Dance Academy <hello@example.com>
# Where admin notifications (instructor applications, contact form) go
# ADMIN_EMAIL=

# ── Production only (docker-compose.prod.yml) ──────────────────────────────
# Public domain; Caddy gets its HTTPS certificate for it. APP_URL is derived.
# DOMAIN=academy.example.com
# POSTGRES_PASSWORD=

# First admin account, created on startup while no admin exists.
# Remove the password once you've signed in and changed it.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
